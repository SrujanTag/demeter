    "lucide-react": "^1.51.0",
    "mongodb": "7.7.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "11.2.1",
    "react": "19.2.8",
