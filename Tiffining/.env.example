# Core MongoDB & Auth Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=tiffining
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters-long-secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ORIGIN=http://localhost:3000
APP_ENV=development

# NVIDIA NIM AI Configuration
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PROVIDER=nvidia
NVIDIA_EXTRACTION_MODEL=google/gemma-2-27b-it
NVIDIA_VERIFICATION_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
AI_DAILY_REQUEST_LIMIT=100
AI_DAILY_INPUT_TOKEN_LIMIT=1000000
AI_MAX_INPUT_TOKENS=16000
AI_TOTAL_TIMEOUT_MS=45000
AI_STAGE_TIMEOUT_MS=20000

# Optional Services
TABPFN_SERVICE_URL=
TABPFN_SERVICE_TOKEN=
SENTRY_DSN=
ELEVENLABS_API_KEY=
